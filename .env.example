# Copy this file to .env and fill in your API key
# The .env file is gitignored and will not be committed

# Leonardo.ai (recommended) - https://app.leonardo.ai/api-access
LEONARDO_API_KEY=your-key-here

# OpenAI (alternative) - https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-key-here

# Stability AI (alternative) - https://platform.stability.ai/account/keys
# STABILITY_API_KEY=your-key-here
